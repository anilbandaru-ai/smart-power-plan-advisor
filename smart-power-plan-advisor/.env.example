# Copy to .env locally. Never commit or paste real keys into chat.
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=power-plan-documents
PINECONE_NAMESPACE=power-plans
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
OPENAI_RAG_MODEL=gpt-4.1-mini
# Optional: absolute path; default is application .data/knowledge.json.
# RAG_MANIFEST_PATH=

# Optional SQLite PDF catalog and matching PDF root for API/CLI:
# PLAN_CATALOG_DB_PATH=
# PLAN_DATA_DIR=

# Agentic RAG assurance (no reranker)
RAG_HYBRID_SEARCH=true
# Optional local OCR; install Tesseract separately before enabling.
RAG_OCR_ENABLED=false
RAG_OCR_COMMAND=tesseract
# Optional blended token prices for monitoring; unset means unknown monetary cost.
# RAG_INPUT_USD_PER_MILLION=
# RAG_OUTPUT_USD_PER_MILLION=
